    "title": "Survival72™ Modular System Configurator",
    "body_html": "\n<style>\n  .s72-wrap { max-width: 860px; margin: 0 auto; font-family: inherit; color: #1a1a1a; }\n\n  /* Mode toggle */\n  .s72-toggle { display: flex; gap: 8px; margin-bottom: 24px; }\n  .s72-toggle-btn {\n    flex: 1; padding: 14px 10px; border: 1.5px solid #d0d0d0;\n    background: #fafafa; cursor: pointer; text-align: center;\n    font-size: 12px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase;\n    transition: all 0.2s; line-height: 1.3;\n  }\n  .s72-toggle-btn.active { border-color: #1a1a1a; background: #1a1a1a; color: #fff; }\n  .s72-toggle-btn.elite { border-color: #b8934a; background: #b8934a; color: #fff; }\n\n  /* Grid */\n  .s72-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }\n  @media (max-width: 600px) { .s72-grid { grid-template-columns: 1fr; } }\n\n  /* Cards */\n  .s72-card {\n    border: 1.5px solid #e0e0e0; background: #fff; cursor: pointer;\n    transition: all 0.2s; position: relative; overflow: hidden;\n    display: flex; flex-direction: column;\n  }\n  .s72-card:hover { border-color: #aaa; }\n  .s72-card.selected { border-color: #1a1a1a; border-width: 2px; }\n  .s72-card.selected::after {\n    content: '✓'; position: absolute; top: 10px; right: 10px;\n    width: 22px; height: 22px; background: #1a1a1a; color: #fff;\n    border-radius: 50%; font-size: 12px; font-weight: 700;\n    display: flex; align-items: center; justify-content: center;\n    line-height: 22px; text-align: center;\n  }\n\n  /* Card image area */\n  .s72-card-img {\n    width: 100%; aspect-ratio: 1/1; overflow: hidden;\n    background: #f5f5f5; display: flex; align-items: center; justify-content: center;\n  }\n  .s72-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n  /* Card body */\n  .s72-card-body { padding: 14px 14px 16px; flex: 1; display: flex; flex-direction: column; gap: 4px; }\n  .s72-card-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #888; }\n  .s72-card-name { font-size: 14px; font-weight: 700; }\n  .s72-card-price { font-size: 14px; font-weight: 600; margin-top: auto; padding-top: 8px; }\n\n  /* Gift box */\n  .s72-gift {\n    border: 1.5px dashed #d0b980; background: #fffdf5;\n    padding: 20px; margin-top: 4px; cursor: pointer;\n    transition: all 0.3s; position: relative;\n    display: flex; align-items: center; gap: 16px;\n  }\n  .s72-gift.locked { opacity: 0.45; pointer-events: none; cursor: default; }\n  .s72-gift.selected { border-style: solid; border-color: #b8934a; border-width: 2px; }\n  .s72-gift-img {\n    width: 72px; min-width: 72px; height: 72px;\n    background: #f0ead8; border-radius: 4px; overflow: hidden;\n    display: flex; align-items: center; justify-content: center; font-size: 32px;\n  }\n  .s72-gift-img img { width: 100%; height: 100%; object-fit: cover; }\n  .s72-gift-info { flex: 1; }\n  .s72-gift-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; }\n  .s72-gift-desc { font-size: 12px; color: #777; margin-top: 4px; line-height: 1.4; }\n  .s72-gift-price { font-size: 16px; font-weight: 700; color: #b8934a; white-space: nowrap; }\n  .s72-gift-unlock {\n    position: absolute; inset: 0; background: rgba(255,255,255,0.7);\n    display: flex; align-items: center; justify-content: center;\n    font-size: 12px; font-weight: 700; color: #aaa; letter-spacing: 1px; text-transform: uppercase;\n  }\n  .s72-gift:not(.locked) .s72-gift-unlock { display: none; }\n\n  /* Price bar */\n  .s72-pricebar {\n    margin-top: 20px; background: #1a1a1a; color: #fff;\n    padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;\n  }\n  .s72-pricebar-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #888; margin-bottom: 4px; }\n  .s72-pricebar-total { font-size: 28px; font-weight: 700; font-family: monospace; }\n  .s72-pricebar-savings { font-size: 12px; font-weight: 700; color: #C9A96E; letter-spacing: 1px; text-transform: uppercase; }\n  .s72-pricebar-none { font-size: 13px; color: #666; }\n</style>\n\n<div class=\"s72-wrap\">\n\n  <!-- Mode toggle -->\n  <div class=\"s72-toggle\">\n    <div class=\"s72-toggle-btn\" id=\"s72-btn-custom\" onclick=\"s72SetMode('custom')\">\n      Build Your Kit<br><span style=\"font-size:10px;font-weight:400;opacity:.7\">Choose any combination</span>\n    </div>\n    <div class=\"s72-toggle-btn\" id=\"s72-btn-elite\" onclick=\"s72SetMode('elite')\">\n      Elite Gift Set — $145<br><span style=\"font-size:10px;font-weight:400;opacity:.7\">All 3 tools + Magnetic Box</span>\n    </div>\n  </div>\n\n  <!-- 3 Tool Cards -->\n  <div class=\"s72-grid\">\n\n    <div class=\"s72-card\" id=\"s72-card-pliers\" onclick=\"s72ToggleTool('pliers')\">\n      <div class=\"s72-card-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0751/9030/4813/files/s72_pliers_1.png\" alt=\"Precision Pliers\">\n      </div>\n      <div class=\"s72-card-body\">\n        <div class=\"s72-card-label\">Module 01 — Pliers</div>\n        <div class=\"s72-card-name\">Precision Multi-Pliers</div>\n        <div class=\"s72-card-price\" id=\"s72-price-pliers\">$52</div>\n      </div>\n    </div>\n\n    <div class=\"s72-card\" id=\"s72-card-wrench\" onclick=\"s72ToggleTool('wrench')\">\n      <div class=\"s72-card-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0751/9030/4813/files/s72_wrench_1.jpg\" alt=\"Roadside Wrench\">\n      </div>\n      <div class=\"s72-card-body\">\n        <div class=\"s72-card-label\">Module 02 — Wrench</div>\n        <div class=\"s72-card-name\">Roadside Wrench</div>\n        <div class=\"s72-card-price\" id=\"s72-price-wrench\">$42</div>\n      </div>\n    </div>\n\n    <div class=\"s72-card\" id=\"s72-card-axe\" onclick=\"s72ToggleTool('axe')\">\n      <div class=\"s72-card-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0751/9030/4813/files/s72_axe_1.jpg\" alt=\"Breacher Axe\">\n      </div>\n      <div class=\"s72-card-body\">\n        <div class=\"s72-card-label\">Module 03 — Axe</div>\n        <div class=\"s72-card-name\">Desert Breacher Axe</div>\n        <div class=\"s72-card-price\" id=\"s72-price-axe\">$49</div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Elite Gift Box -->\n  <div class=\"s72-gift locked\" id=\"s72-gift\" onclick=\"s72ToggleGift()\">\n    <div class=\"s72-gift-unlock\">Select all 3 modules to unlock</div>\n    <div class=\"s72-gift-img\">🎁</div>\n    <div class=\"s72-gift-info\">\n      <div class=\"s72-gift-title\">Elite Magnetic Gift Box</div>\n      <div class=\"s72-gift-desc\">Premium clamshell case, custom EVA foam inlays, S72 Field Guide. Gift-ready from the factory.</div>\n    </div>\n    <div class=\"s72-gift-price\">+ $29</div>\n  </div>\n\n  <!-- Price bar -->\n  <div class=\"s72-pricebar\">\n    <div>\n      <div class=\"s72-pricebar-label\">Kit Total</div>\n      <div class=\"s72-pricebar-total\" id=\"s72-total\">$0.00</div>\n    </div>\n    <div style=\"text-align:right\">\n      <div class=\"s72-pricebar-savings\" id=\"s72-savings\"></div>\n      <div class=\"s72-pricebar-none\" id=\"s72-none\">Select a module to begin</div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function() {\n  // --- Variant map ---\n  // key: \"pliers-wrench-axe-box\" (each 1 or 0)\n  var VARIANTS = {\n    '0-0-1-0': { id: 44902740820013, price: 49 },\n    '1-1-0-0': { id: 44902746882093, price: 79 },\n    '1-1-1-0': { id: 44902746914861, price: 116 },\n    '1-1-1-1': { id: 44902746947629, price: 145 },\n    '1-0-0-0': { id: 44902746980397, price: 52 },\n    '1-0-1-0': { id: 44902747013165, price: 86 },\n    '0-1-0-0': { id: 44902747078701, price: 42 },\n    '0-1-1-0': { id: 44902747111469, price: 76 },\n  };\n\n  var BASE = { pliers: 52, wrench: 42, axe: 49 };\n  var sel = { pliers: false, wrench: false, axe: false };\n  var giftSelected = false;\n\n  function variantKey() {\n    return (sel.pliers?1:0)+'-'+(sel.wrench?1:0)+'-'+(sel.axe?1:0)+'-'+(giftSelected?1:0);\n  }\n\n  function countSelected() {\n    return (sel.pliers?1:0) + (sel.wrench?1:0) + (sel.axe?1:0);\n  }\n\n  function update() {\n    // Cards\n    ['pliers','wrench','axe'].forEach(function(t) {\n      var card = document.getElementById('s72-card-'+t);\n      if (card) {\n        if (sel[t]) card.classList.add('selected');\n        else card.classList.remove('selected');\n      }\n    });\n\n    // Gift box\n    var gift = document.getElementById('s72-gift');\n    var all3 = countSelected() === 3;\n    if (gift) {\n      if (all3) gift.classList.remove('locked'); else { gift.classList.add('locked'); giftSelected = false; }\n      if (giftSelected) gift.classList.add('selected'); else gift.classList.remove('selected');\n    }\n\n    // Price calculation\n    var count = countSelected();\n    var subtotal = (sel.pliers?52:0) + (sel.wrench?42:0) + (sel.axe?49:0);\n    var discount = count === 2 ? 15 : count === 3 ? 27 : 0;\n    var total = subtotal - discount + (giftSelected ? 29 : 0);\n\n    var totalEl = document.getElementById('s72-total');\n    var savingsEl = document.getElementById('s72-savings');\n    var noneEl = document.getElementById('s72-none');\n    if (totalEl) totalEl.textContent = count > 0 || giftSelected ? '$' + total.toFixed(2) : '$0.00';\n    if (savingsEl) savingsEl.textContent = discount > 0 ? 'You save $' + discount : '';\n    if (noneEl) noneEl.style.display = count === 0 ? '' : 'none';\n\n    // Sync Shopify variant\n    var key = variantKey();\n    var variant = VARIANTS[key];\n    if (variant) {\n      syncVariant(variant.id);\n    }\n  }\n\n  function syncVariant(variantId) {\n    // Update hidden variant input in Shopify product form\n    var inputs = document.querySelectorAll('input[name=\"id\"], [data-variant-id]');\n    inputs.forEach(function(el) {\n      el.value = variantId;\n    });\n    // Also try to trigger Shopify's variant change event\n    var form = document.querySelector('form[action*=\"/cart/add\"], product-form form, .product-form form');\n    if (form) {\n      var hiddenInput = form.querySelector('input[name=\"id\"]');\n      if (hiddenInput) {\n        hiddenInput.value = variantId;\n        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n    }\n    // Update URL\n    var url = new URL(window.location.href);\n    url.searchParams.set('variant', variantId);\n    window.history.replaceState({}, '', url.toString());\n  }\n\n  window.s72ToggleTool = function(tool) {\n    sel[tool] = !sel[tool];\n    // reset elite button\n    document.getElementById('s72-btn-elite').classList.remove('elite');\n    document.getElementById('s72-btn-custom').classList.add('active');\n    update();\n  };\n\n  window.s72ToggleGift = function() {\n    if (countSelected() < 3) return;\n    giftSelected = !giftSelected;\n    update();\n  };\n\n  window.s72SetMode = function(mode) {\n    if (mode === 'elite') {\n      sel = { pliers: true, wrench: true, axe: true };\n      giftSelected = true;\n      document.getElementById('s72-btn-elite').classList.add('elite');\n      document.getElementById('s72-btn-custom').classList.remove('active');\n    } else {\n      document.getElementById('s72-btn-custom').classList.add('active');\n      document.getElementById('s72-btn-elite').classList.remove('elite');\n    }\n    update();\n  };\n\n  // Init on load\n  document.addEventListener('DOMContentLoaded', function() {\n    var params = new URLSearchParams(window.location.search);\n    if (params.get('auto_kit') === 'elite') {\n      s72SetMode('elite');\n    } else {\n      update();\n    }\n  });\n})();\n</script>\n",
